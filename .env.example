# Safe local defaults for the standalone mock Task service.
MOCK_TASK_API_BASE_URL=http://127.0.0.1:8001
MOCK_TASK_API_HOST=127.0.0.1
MOCK_TASK_API_PORT=8001

# Safe local defaults for the bounded TASK-005 Qwen Code/Ollama probe.
# The placeholder API key satisfies the OpenAI-compatible client; local Ollama
# does not require authentication unless a proxy or gateway adds it.
QWEN_OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
QWEN_OLLAMA_MODEL=qwen3:0.6b
QWEN_OLLAMA_API_KEY=ollama
QWEN_OLLAMA_REQUEST_TIMEOUT_SECONDS=300
QWEN_OLLAMA_WALL_TIME_SECONDS=360
QWEN_OLLAMA_MAX_TOKENS=384
QWEN_OLLAMA_MAX_SESSION_TURNS=6
QWEN_OLLAMA_MAX_TOOL_CALLS=2

# TASK-008/TASK-009 Agent Orchestrator foundation and lifecycle API. These are safe local deployment
# examples; .env is not loaded automatically and real credentials stay outside
# the repository.
UAR_API_HOST=127.0.0.1
UAR_API_PORT=8080
UAR_RUNTIME_DRIVER=docker
UAR_DOCKER_WORKLOAD_KEY=qwen-agent-image
UAR_DOCKER_WORKLOAD_IMAGE=uar-task007-agent:local
UAR_DOCKER_WORKLOAD_COMMAND_JSON=["serve"]
UAR_DOCKER_WORKLOAD_USER=10001:10001
UAR_DOCKER_WORKSPACE_TARGET=/workspace
UAR_DOCKER_NETWORK_MODE=bridge
UAR_DOCKER_NETWORK_HOST=host.docker.internal
UAR_DOCKER_NETWORK_PORT=11434
UAR_DOCKER_HEALTHCHECK_INTERVAL_SECONDS=1
UAR_DOCKER_HEALTHCHECK_TIMEOUT_SECONDS=2
UAR_DOCKER_HEALTHCHECK_RETRIES=30
UAR_DOCKER_HEALTHCHECK_START_PERIOD_SECONDS=1
UAR_AGENT_CPU_CORES=1.0
UAR_AGENT_MEMORY_BYTES=1073741824
UAR_AGENT_OPERATION_TIMEOUT_SECONDS=30
UAR_AGENT_READINESS_TIMEOUT_SECONDS=30
UAR_AGENT_READINESS_POLL_INTERVAL_SECONDS=0.1
UAR_QWEN_SESSION_STORAGE_ROOT=.runtime/qwen-sessions
UAR_QWEN_BASE_URL=http://host.docker.internal:11434/v1
UAR_QWEN_MODEL=qwen3:1.7b
UAR_QWEN_API_KEY_SECRET_ID=local-ollama-key
UAR_QWEN_API_KEY=ollama

# TASK-010 non-streaming chat bounds. Excess history is rejected, never truncated.
UAR_CHAT_MAX_MESSAGE_CHARACTERS=16384
UAR_CHAT_MAX_RESPONSE_CHARACTERS=16384
UAR_CHAT_MAX_HISTORY_MESSAGES=100
UAR_CHAT_MAX_HISTORY_PAGE_SIZE=50

# TASK-011 SSE uses committed response content, not token deltas.
UAR_STREAM_HEARTBEAT_SECONDS=15
UAR_STREAM_SEND_TIMEOUT_SECONDS=10
