{
  "info": {
    "_postman_id": "d52a8245-4dc9-4a57-98c5-cc4b3d5c1c2d",
    "name": "Universal Agent Runtime — server E2E",
    "description": "Нет credentials. Сначала создайте и запустите Agent, затем выполните AG-UI run. Postman отображает SSE как поток raw response.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8080" },
    { "key": "agent_id", "value": "" },
    { "key": "task_id", "value": "" },
    { "key": "thread_id", "value": "postman-thread-1" },
    { "key": "run_id", "value": "postman-run-1" },
    { "key": "skill_id", "value": "uploaded-skill" }
  ],
  "item": [
    {
      "name": "Health",
      "request": { "method": "GET", "url": "{{base_url}}/healthz" }
    },
    {
      "name": "Readiness",
      "request": { "method": "GET", "url": "{{base_url}}/readyz" }
    },
    {
      "name": "List Skills",
      "request": { "method": "GET", "url": "{{base_url}}/skills" }
    },
    {
      "name": "Get Skill",
      "request": { "method": "GET", "url": "{{base_url}}/skills/{{skill_id}}" }
    },
    {
      "name": "Install Skill from archive",
      "request": {
        "method": "POST",
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "source_type", "value": "archive", "type": "text" },
            { "key": "skill_id", "value": "{{skill_id}}", "type": "text" },
            { "key": "archive", "type": "file", "src": [] }
          ]
        },
        "url": "{{base_url}}/skills"
      }
    },
    {
      "name": "Install Skill from Git — expected unavailable",
      "request": {
        "method": "POST",
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "source_type", "value": "git", "type": "text" },
            { "key": "skill_id", "value": "architecture-review", "type": "text" },
            { "key": "repository_url", "value": "https://example.com/owner/repo.git", "type": "text" },
            { "key": "revision", "value": "main", "type": "text" },
            { "key": "path", "value": "skills/example", "type": "text" }
          ]
        },
        "url": "{{base_url}}/skills"
      }
    },
    {
      "name": "Create Agent with uploaded Skill",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const body = pm.response.json();",
              "pm.collectionVariables.set('agent_id', body.agent_id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"request_id\": \"uploaded-agent-{{$guid}}\",\n  \"skills\": [\"{{skill_id}}\"],\n  \"tools\": []\n}"
        },
        "url": "{{base_url}}/agents"
      }
    },
    {
      "name": "Create Agent",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const body = pm.response.json();",
              "pm.collectionVariables.set('agent_id', body.agent_id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"request_id\": \"postman-{{$guid}}\",\n  \"skills\": [\"task-decomposition\"],\n  \"tools\": [\"get_task\", \"create_task\", \"create_epic\", \"add_child_task\"]\n}"
        },
        "url": "{{base_url}}/agents"
      }
    },
    {
      "name": "Start Agent",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/agents/{{agent_id}}/start"
      }
    },
    {
      "name": "Agent Debug Report",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/agents/{{agent_id}}/debug-report"
      }
    },
    {
      "name": "Agent Internal Files",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/agents/{{agent_id}}/files"
      }
    },
    {
      "name": "Create development Skills Agent (no tools)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"request_id\": \"dev-agent-{{$guid}}\",\n  \"skills\": [\"decomposition-2\", \"code-implementation\", \"code-testing\", \"code-review\"],\n  \"tools\": []\n}"
        },
        "url": "{{base_url}}/agents"
      }
    },
    {
      "name": "AG-UI Run (SSE)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "text/event-stream" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"threadId\": \"{{thread_id}}\",\n  \"runId\": \"{{run_id}}\",\n  \"state\": {},\n  \"messages\": [{\n    \"id\": \"postman-message-1\",\n    \"role\": \"user\",\n    \"content\": \"Создай тестовый Epic в TTEST2 с названием Postman Epic и описанием Проверка создания Epic, затем декомпозируй его на 3 обычные задачи.\"\n  }],\n  \"tools\": [],\n  \"context\": [],\n  \"forwardedProps\": {}\n}"
        },
        "url": "{{base_url}}/ag-ui/agents/{{agent_id}}/run"
      }
    },
    {
      "name": "Create Java Development Agent",
      "event": [{ "listen": "test", "script": { "exec": ["pm.collectionVariables.set('agent_id', pm.response.json().agent_id);"] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"request_id\":\"java-{{$guid}}\",\"skills\":[\"requirements-clarification\",\"development-planning\",\"java-project-setup\",\"java-implementation\",\"java-testing\",\"code-review\"],\"tools\":[]}" },
        "url": "{{base_url}}/agents",
        "description": "После создания выполнить Start Agent. Требуется UAR_JAVA_DEVELOPMENT_ENABLED=true."
      }
    },
    {
      "name": "Create Java Development Task",
      "event": [{ "listen": "test", "script": { "exec": ["pm.collectionVariables.set('task_id', pm.response.json().task_id);"] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"specification\":\"Создай библиотеку Java 21 Calculator.add(int,int) и JUnit 5 тесты для положительных, отрицательных чисел и нуля. Добавь Maven build и .gitignore. Без внешних сервисов.\",\"build_system\":\"maven\",\"branch\":\"main\",\"publish\":false,\"max_fix_attempts\":2}" },
        "url": "{{base_url}}/agents/{{agent_id}}/development-tasks"
      }
    },
    {
      "name": "AG-UI Development Run (SSE)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Accept", "value": "text/event-stream" }],
        "body": { "mode": "raw", "raw": "{\"threadId\":\"{{thread_id}}\",\"runId\":\"{{$guid}}\"}" },
        "url": "{{base_url}}/ag-ui/development-tasks/{{task_id}}/run",
        "description": "Проверка AG-UI protocol/E2E. Для диагностики использовать Development Trace и Agent LLM Turns."
      }
    },
    {
      "name": "Development Trace",
      "request": { "method": "GET", "url": "{{base_url}}/development-tasks/{{task_id}}/trace",
        "description": "Состояние и единый журнал фактических workflow событий, включая failed/cancelled и повторные попытки." }
    },
    {
      "name": "Agent LLM Turns",
      "request": { "method": "GET", "url": "{{base_url}}/agents/{{agent_id}}/llm-turns?after=0&limit=10",
        "description": "Завершённые native Qwen turns: безопасный current prompt, конечный observable assistant и доступная telemetry. При активном turn возможен 409; продолжение страницы через next_after." }
    },
    {
      "name": "Legacy committed SSE",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "text/event-stream" }
        ],
        "body": { "mode": "raw", "raw": "{\"content\":\"Покажи краткий план без вызова Tool.\"}" },
        "url": "{{base_url}}/agents/{{agent_id}}/messages/stream"
      }
    }
  ]
}
